{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictFunctionTypes": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false,
    "noUnusedLocals": false,
    "noUnusedParameters": true
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../cosmokit"
    }
  ]
}
